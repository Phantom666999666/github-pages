<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Página de Juegos</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #1a1a1a;
            color: #fff;
            margin: 0;
            padding: 0;
            text-align: center;
        }
        header {
            background-color: #333;
            padding: 20px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.5);
        }
        header h1 {
            margin: 0;
            font-size: 2.5em;
        }
        .container {
            max-width: 1200px;
            margin: 20px auto;
            padding: 0 20px;
        }
        .game-list {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
        }
        .game-card {
            background-color: #2a2a2a;
            border-radius: 10px;
            padding: 15px;
            transition: transform 0.2s;
        }
        .game-card:hover {
            transform: scale(1.05);
        }
        .game-card img {
            width: 100%;
            border-radius: 5px;
        }
        .game-card h3 {
            margin: 10px 0;
            font-size: 1.2em;
        }
        .game-card a {
            display: inline-block;
            background-color: #007bff;
            color: #fff;
            padding: 10px 15px;
            border-radius: 5px;
            text-decoration: none;
            margin-top: 10px;
        }
        .game-card a:hover {
            background-color: #0056b3;
        }
        footer {
            background-color: #333;
            padding: 10px;
            position: fixed;
            bottom: 0;
            width: 100%;
        }
    </style>
</head>
<body>
    <header>
        <h1>Mi Página de Juegos</h1>
        <p>¡Descarga juegos gratis y diviértete!</p>
    </header>
    <div class="container">
        <h2>Juegos Disponibles</h2>
        <div class="game-list" id="game-list">
            <!-- Los juegos se añadirán aquí con JavaScript -->
        </div>
    </div>
    <footer>
        <p>&copy; 2025 Mi Página de Juegos. Todos los derechos reservados.</p>
    </footer>

    <script>
        // Lista de juegos (puedes añadir más)
        const games = [
            {
                title: "Aventura Espacial",
                image: "https://via.placeholder.com/250x150?text=Aventura+Espacial",
                downloadLink: "https://mega.nz/file/xxxxxxxx" // Reemplaza con tu enlace de MEGA o Google Drive
            },
            {
                title: "Carrera Infinita",
                image: "https://via.placeholder.com/250x150?text=Carrera+Infinita",
                downloadLink: "https://mega.nz/file/xxxxxxxx" // Reemplaza con tu enlace
            }
        ];

        // Función para mostrar los juegos
        function displayGames() {
            const gameList = document.getElementById("game-list");
            games.forEach(game => {
                const gameCard = document.createElement("div");
                gameCard.className = "game-card";
                gameCard.innerHTML = `
                    <img src="${game.image}" alt="${game.title}">
                    <h3>${game.title}</h3>
                    <a href="${game.downloadLink}" target="_blank">Descargar</a>
                `;
                gameList.appendChild(gameCard);
            });
        }

        // Cargar los juegos al iniciar la página
        window.onload = displayGames;
    </script>
</body>
</html>
